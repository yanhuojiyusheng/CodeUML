{
  "name": "tstouml",
  "version": "1.0.0",
  "description": "TypeScript to UML Class Diagram Converter",
  "main": "src/main.ts",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020",
    "dev": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020 --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "esbuild": "^0.20.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12"
  }
}
